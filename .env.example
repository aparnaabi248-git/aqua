# AquaGuard AI — copy to .env and fill in. Never commit real secrets.
# Live sensor/API integration (set ONE of these; leave unset to stay on HISTORICAL/SIMULATED):
# CSV whose LAST row has PH_S,DBO_S,DQO_S,SS_S,COND_S (+ optional timestamp,sample_id)
AQUAGUARD_LIVE_CSV=
# JSON file with keys PH_S,DBO_S,DQO_S,SS_S,COND_S
AQUAGUARD_LIVE_JSON=
# HTTPS endpoint returning JSON with keys PH_S,DBO_S,DQO_S,SS_S,COND_S
AQUAGUARD_LIVE_URL=
# Government Data page defaults (NWDP/CPCB; public CKAN API, no key required)
# AQUAGUARD_GOVT_STATE=Tamil Nadu
# AQUAGUARD_GOVT_PERIOD=2021 - 2025
